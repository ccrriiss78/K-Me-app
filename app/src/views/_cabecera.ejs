<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= titulo %> · K-ME</title>
  <link rel="icon" href="/img/favicon-kme.ico">
  <link rel="stylesheet" href="/css/estilos.css">
  <link rel="stylesheet" href="/css/identidad.css">
  <%# Hojas de estilo propias de una página (por ejemplo, el editor de Avatar Studio). %>
  <% for (const hoja of (locals.estilosExtra || [])) { %>
  <link rel="stylesheet" href="<%= hoja %>">
  <% } %>
</head>
<body>
  <%# Páginas de entrada («Entrar» y «Crear cuenta», que solo se ven sin sesión): sin barra de
      cabecera, porque el logo va grande dentro de la tarjeta (T014). Se marcan al incluir este
      archivo con { paginaDeEntrada: true }. %>
  <% const paginaDeEntrada = locals.paginaDeEntrada === true && !aliasSesion; %>
  <% if (!paginaDeEntrada) { %>
  <header class="cabecera">
    <a class="marca" href="/">
      <img src="/img/logo-kme.svg" alt="K-ME" width="28" height="40">
    </a>
    <% if (aliasSesion) { %>
      <%# Menú principal: aria-current marca la página en la que estás. %>
      <nav class="menu" aria-label="Principal">
        <a href="/mi-kme"<% if (locals.rutaActual === '/mi-kme') { %> aria-current="page"<% } %>>Mi K-ME</a>
        <a href="/studio/avatares"<% if ((locals.rutaActual || '').startsWith('/studio/avatares')) { %> aria-current="page"<% } %>>Avatar Studio</a>
        <a href="/studio/sellos"<% if ((locals.rutaActual || '').startsWith('/studio/sellos')) { %> aria-current="page"<% } %>>Sello Studio</a>
        <a href="/connect"<% if (locals.rutaActual === '/connect') { %> aria-current="page"<% } %>>Connect</a>
        <a href="/escenario"<% if ((locals.rutaActual || '').startsWith('/escenario')) { %> aria-current="page"<% } %>>Mi escenario</a>
      </nav>
      <nav class="nav" aria-label="Sesión">
        <%# Imagen de perfil (D044): la cara del avatar o, si solo hay sello, el sello. El SVG lo dibuja
            el servidor a partir de recetas validadas, nunca algo enviado por el navegador. Es
            decorativa: al lado va el alias. Sin imagen de perfil, la cabecera queda como antes. %>
        <span class="nav__alias"><% if (locals.perfilSesion && perfilSesion.cabecera) { %><span class="perfil-cabecera" data-perfil-cabecera="<%= perfilSesion.cabecera.tipo %>" aria-hidden="true"><% if (perfilSesion.cabecera.tipo === 'avatar') { %><%- perfilSesion.cabecera.svg %><% } else { %><%- include('_sello', { dibujo: perfilSesion.cabecera.dibujo, ancho: perfilSesion.cabecera.ancho, clase: 'sello--cabecera' }) %><% } %></span> <% } %>Hola, <strong><%= aliasSesion %></strong></span>
        <%# Saldo de Kpopis (D063): lo calcula el servidor (middleware/kpopis.js). Lleva a «Mis Kpopis».
            En el móvil se ve solo el número con el icono; la palabra sigue ahí para los lectores de pantalla. %>
        <% if (locals.kpopisSesion) { %>
        <a class="saldo-kpopis" href="/mi-kme#mis-kpopis"><img src="<%= kpopisSesion.icono %>" alt="" width="20" height="20"><span><%= kpopisSesion.saldo %><span class="saldo-kpopis__nombre"> <%= kpopisSesion.nombre %></span></span></a>
        <% } %>
        <form method="post" action="/salir" class="nav__form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="boton boton--secundario">Salir</button>
        </form>
      </nav>
    <% } %>
  </header>
  <% } %>
  <main class="contenido<%= paginaDeEntrada ? ' contenido--entrada' : '' %>">
