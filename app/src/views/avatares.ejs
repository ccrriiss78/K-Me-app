<%- include('_cabecera') %>
<%#
  «Mis avatares» (Avatar Studio, contrato v1). Vista funcional; desde D056 la mantiene Claude.
  Se conservan los textos y enlaces que comprueban tests/avatares.test.js y tests/borrar-varios.test.js.
  Las miniaturas las dibuja el servidor con el dibujador del editor, a partir de la receta ya
  validada (nunca algo enviado por el navegador): por eso se insertan sin escapar.
-%>
<section class="tarjeta avatares-studio" aria-labelledby="titulo-avatares">
  <h1 id="titulo-avatares">Mis avatares</h1>
  <% if (eliminado) { %><p class="aviso aviso--ok" role="status">Avatar borrado.</p><% } %>
  <% if (locals.borrados) { %><p class="aviso aviso--ok" role="status"><%= borrados === 1 ? 'Se ha borrado 1 avatar.' : `Se han borrado ${borrados} avatares.` %></p><% } %>
  <% if (error) { %><p class="aviso aviso--error" role="alert"><%= error %></p><% } %>

  <% if (!avatares.length) { %>
    <p>Todavía no tienes avatares. Crea el primero con el editor de Avatar Studio.</p>
  <% } %>
  <% if (avatares.length < maximo) { %>
    <p><a class="boton" href="/studio/avatares/nuevo">Crear un avatar</a></p>
  <% } %>

  <% if (avatares.length) { %>
    <%# Borrar varios o todos (D058): las casillas de cada avatar pertenecen a este formulario
        (atributo form), porque en HTML no se puede poner un formulario dentro de otro. Antes de
        borrar se pide confirmación. %>
    <form method="post" id="borrar-varios" action="/studio/avatares/borrar" class="borrar-varios">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="boton boton--pequeno boton--secundario">Borrar los seleccionados</button>
      <button type="submit" name="todos" value="si" class="boton boton--pequeno boton--peligro">Borrar todos</button>
    </form>
    <ul class="avatares-lista">
      <% avatares.forEach((a) => { %>
        <li class="avatares-lista__elemento">
          <label class="borrar-varios__casilla"><input type="checkbox" name="ids" value="<%= a.id %>" form="borrar-varios"> <span>Elegir para borrar<span class="solo-lectores">: <%= a.nombre %></span></span></label>
          <a href="/studio/avatares/<%= a.id %>" class="avatares-lista__abrir">
            <span class="avatares-lista__dibujo" aria-hidden="true"><%- a.dibujo %></span>
            <span class="avatares-lista__nombre"><%= a.nombre %></span>
          </a>
          <%# Imagen de perfil (D044): versión funcional; el diseño lo hará ChatGPT. %>
          <% if (locals.perfilSesion && perfilSesion.idAvatar === String(a.id)) { %>
            <p class="perfil-marca">En tu perfil</p>
          <% } else { %>
            <form method="post" action="/perfil/avatar">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="avatar" value="<%= a.id %>">
              <button type="submit" class="boton boton--pequeno boton--secundario">Usar en mi perfil</button>
            </form>
          <% } %>
          <form method="post" action="/studio/avatares/<%= a.id %>/duplicar">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="boton boton--pequeno boton--secundario">Duplicar</button>
          </form>
          <details>
            <summary>Borrar</summary>
            <p>Se borrará para siempre.</p>
            <form method="post" action="/studio/avatares/<%= a.id %>/eliminar">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="boton boton--pequeno boton--peligro">Sí, borrar</button>
            </form>
          </details>
        </li>
      <% }) %>
    </ul>
    <p class="nota">Tienes <%= avatares.length %> de <%= maximo %> avatares.</p>
  <% } %>
</section>
<%- include('_pie') %>
