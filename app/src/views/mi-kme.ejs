<%- include('_cabecera') %>
<%# Composición de la propuesta P031 (E0095): la página, sin recuadro propio. En la portada, primero la
    identidad (la imagen de perfil, con el alias y la fecha de alta) y la votación «TÚ DECIDES»: en dos
    columnas en el ordenador ancho; una debajo de otra en el móvil. Debajo, todo lo demás. %>
<section class="tarjeta mi-kme" aria-labelledby="titulo-mi-kme">
  <h1 id="titulo-mi-kme">Mi K-ME</h1>
  <p class="saludo">Bienvenida, <strong><%= cuenta.alias %></strong>. Este es tu espacio privado.</p>
  <div class="mi-kme__portada">
  <%# Imagen de perfil (D044, D055). Los SVG los dibuja el servidor a partir de recetas validadas. %>
  <section class="perfil" aria-labelledby="titulo-perfil">
    <h2 id="titulo-perfil">Tu imagen de perfil</h2>
    <% if (!perfil.avatar && !perfil.sello) { %>
      <p>Todavía no has elegido tu imagen de perfil. Puedes usar uno de tus avatares, uno de tus sellos o los dos: pulsa «Usar en mi perfil» en Avatar Studio o en Sello Studio.</p>
    <% } %>
    <% if (perfil.avatar) { %>
      <figure class="perfil__imagen" data-perfil="avatar">
        <span role="img" aria-label="Tu avatar de perfil: <%= perfil.avatar.nombre %>"><%- perfil.avatar.svg %></span>
        <figcaption><%= perfil.avatar.nombre %></figcaption>
        <form method="post" action="/perfil/avatar">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="avatar" value="">
          <button type="submit" class="boton boton--pequeno boton--secundario">Quitar el avatar del perfil</button>
        </form>
      </figure>
    <% } %>
    <% if (perfil.sello) { %>
      <figure class="perfil__imagen" data-perfil="sello">
        <%- include('_sello', { dibujo: perfil.sello.dibujo, ancho: perfil.sello.ancho, clase: 'sello--perfil' }) %>
        <figcaption><%= perfil.sello.nombre %></figcaption>
        <form method="post" action="/perfil/sello">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="sello" value="">
          <button type="submit" class="boton boton--pequeno boton--secundario">Quitar el sello del perfil</button>
        </form>
      </figure>
    <% } %>
    <dl class="datos perfil__datos">
      <dt>Alias</dt><dd><%= cuenta.alias %></dd>
      <dt>Cuenta creada</dt><dd><time datetime="<%= cuenta.creado_en.toISOString() %>"><%= cuenta.creado_en.toLocaleString('es-ES') %></time></dd>
    </dl>
  </section>
  <%- include('_tu-decides', { tuDecides }) %>
  </div>
  <!-- fin portada -->
  <%# Mis tesoros (D064, «Mi álbum vivo»): los objetos ganados, con su origen y la fecha. Se ganan,
      nunca se compran. Los dibujos salen del catálogo (src/catalogos/recompensas.js). %>
  <section class="tesoros" id="mis-tesoros" aria-labelledby="titulo-tesoros">
    <h2 id="titulo-tesoros">Mis tesoros</h2>
    <% if (recompensas.tesoros.length === 0) { %>
      <p>Todavía no tienes tesoros. Gana el primero en <a class="enlace" href="/escenario/hangul-live-001">HANGUL LIVE 001</a>.</p>
    <% } else { %>
      <ul class="tesoros__lista">
        <%# Cada tesoro (D082; E0096 y E0097): a la izquierda, el soporte con los materiales de su
            experiencia y el dibujo original, con su luz si se enciende (una capa de adorno vacía); a la
            derecha, sobre blanco, los datos. Esta lista solo trae los tesoros de la cuenta, así que
            «Conseguido» siempre es verdad. %>
        <% for (const t of recompensas.tesoros) { %>
          <li class="tesoro" data-tesoro="<%= t.id %>">
            <div class="tesoro__soporte">
              <span class="tesoro__objeto">
                <img class="tesoro__imagen" src="<%= t.imagen %>" alt="" width="96" height="132">
                <span class="tesoro__luz" aria-hidden="true"></span>
              </span>
            </div>
            <div class="tesoro__info">
              <span class="tesoro__clase"><%= t.clase %></span>
              <span class="tesoro__nombre"><%= t.nombre %></span>
              <%# «Conseguido el» y la fecha en que se ganó, que se lee seguido. %>
              <span class="tesoro__conseguido"><span class="tesoro__estado">Conseguido</span> <span class="tesoro__fecha">el <time datetime="<%= t.fechaIso %>"><%= t.fecha %></time></span></span>
              <span class="tesoro__origen"><strong>Origen:</strong> <%= t.origen %></span>
            </div>
          </li>
        <% } %>
      </ul>
    <% } %>
  </section>
  <%# Mis Kpopis (D063): el saldo y sus movimientos. De momento solo se ganan; el canje, después. %>
  <section class="kpopis" id="mis-kpopis" aria-labelledby="titulo-kpopis">
    <h2 id="titulo-kpopis">Mis Kpopis</h2>
    <p class="kpopis__saldo"><img src="<%= recompensas.iconoKpopi %>" alt="" width="32" height="32"><strong><%= recompensas.saldo %></strong></p>
    <p class="nota">De momento se ganan en Mi escenario. Todavía no se pueden gastar.</p>
    <% if (recompensas.movimientos.length === 0) { %>
      <p>Todavía no tienes movimientos.</p>
    <% } else { %>
      <h3 class="kpopis__subtitulo">Movimientos</h3>
      <ol class="kpopis__movimientos">
        <% for (const m of recompensas.movimientos) { %>
          <li><strong><%= m.cantidad %></strong> · <%= m.concepto %> · <time datetime="<%= m.fechaIso %>"><%= m.fecha %></time></li>
        <% } %>
      </ol>
    <% } %>
  </section>
  <p><a class="boton boton--enlace" href="/escenario">Ir a Mi escenario</a></p>
  <p><a class="boton boton--enlace" href="/studio/avatares">Crear tus avatares en Avatar Studio</a></p>
  <p><a class="boton boton--enlace" href="/studio/sellos">Crear tus sellos en Sello Studio</a></p>
  <p><a class="boton boton--enlace" href="/connect">Ir al muro de Connect</a></p>
</section>
<%# Votar sin recargar la página (E0098); sin JavaScript, el formulario funciona igual. %>
<script src="/js/tu-decides.js" defer></script>
<%- include('_pie') %>
