<%- include('_cabecera') %>
<%#
  Connect (D038): el muro de los fans. Sin JavaScript: cada acción es un formulario que vuelve al muro.
  Las emociones y reacciones salen del catálogo (src/catalogos/connect.js) y los dibujos, de
  public/img/connect/; colores y tamaños, de las variables «--connect-…» de estilos.css.
%>
<div class="connect">
  <header class="connect__cabeza">
    <h1 class="connect__titulo">Connect</h1>
    <p class="connect__subtitulo">El muro de los fans: cuenta cómo te sientes y reacciona a los demás.</p>
  </header>

  <% if (publicada) { %><p class="aviso aviso--ok" role="status">¡Publicado en el muro!</p><% } %>
  <% if (eliminada) { %><p class="aviso aviso--ok" role="status">Publicación borrada.</p><% } %>
  <% if (error) { %><p class="aviso aviso--error" role="alert"><%= error %></p><% } %>

  <%# En el ordenador, dos columnas: el muro a la izquierda y «Publicar» en un panel lateral que se
      queda fijo al bajar. En el móvil, «Publicar» va arriba, con las emociones en una fila que se
      desliza. En el código va primero «Publicar», que es el orden de lectura con teclado. %>
  <div class="connect__columnas">
  <aside class="connect__lateral" aria-label="Publicar en el muro">
  <form method="post" action="/connect/publicaciones" class="publicar">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <fieldset class="publicar__grupo">
      <legend class="publicar__pregunta">¿Cómo te sientes hoy?</legend>
      <div class="emociones">
        <% emociones.forEach((e) => { %>
          <input class="emocion__radio" type="radio" name="emocion" id="emocion-<%= e.id %>" value="<%= e.id %>" required>
          <label class="emocion" for="emocion-<%= e.id %>">
            <img src="<%= e.icono %>" alt="" width="40" height="40">
            <span><%= e.texto %></span>
          </label>
        <% }) %>
      </div>
    </fieldset>

    <%# El diseño que acompaña a la emoción (Q7, Q11): la publicación guarda una copia. %>
    <% const disenos = locals.disenos ?? { avatares: [], sellos: [] }; %>
    <div class="publicar__grupo publicar__diseno">
      <label for="diseno" class="publicar__pregunta">¿Con qué diseño?</label>
      <select id="diseno" name="diseno" class="publicar__desplegable" aria-describedby="ayuda-diseno">
        <option value="" selected>Mi imagen de perfil</option>
        <% if (disenos.avatares.length) { %><optgroup label="Mis avatares">
          <% disenos.avatares.forEach((a) => { %><option value="avatar:<%= a.id %>"><%= a.nombre %></option>
        <% }) %></optgroup><% } %>
        <% if (disenos.sellos.length) { %><optgroup label="Mis sellos">
          <% disenos.sellos.forEach((s) => { %><option value="sello:<%= s.id %>"><%= s.nombre %></option>
        <% }) %></optgroup><% } %>
      </select>
      <p id="ayuda-diseno" class="nota">Si no eliges, va tu imagen de perfil, o tu inicial si no tienes. Se guarda una copia: aunque después cambies o borres el diseño, la publicación no cambia.</p>
      <% if (!disenos.avatares.length && !disenos.sellos.length) { %>
        <p class="nota">Todavía no tienes avatares ni sellos. <a href="/studio/avatares/nuevo">Crea uno en Avatar Studio</a>.</p>
      <% } %>
    </div>

    <%# Mensaje con iconos (opcional): sin JavaScript, 5 desplegables; con JavaScript, el script
        public/js/connect-publicar.js los esconde y pone una paleta con los dibujos, que rellena
        esos mismos desplegables (son los que se envían). %>
    <% if (locals.iconosMensaje) { %>
    <details class="mensaje">
      <summary>Añadir un mensaje con iconos <span class="mensaje__opcional">(opcional)</span></summary>
      <%# Qué es el mensaje (D084): sale delante de los iconos en el muro. Sin elegir, «Mensaje». %>
      <fieldset class="publicar__grupo mensaje__tipos">
        <legend class="mensaje__tipos-titulo">¿Qué es?</legend>
        <div class="mensaje__tipos-opciones">
          <% (locals.tiposMensaje ?? []).forEach((t) => { %>
            <label class="mensaje__tipo"><input type="radio" name="tipo_mensaje" value="<%= t.id %>"<%= t.id === tipoMensajePorDefecto ? ' checked' : '' %>> <span><%= t.texto %></span></label>
          <% }) %>
        </div>
      </fieldset>
      <fieldset class="publicar__grupo mensaje__grupo-campos" data-mensaje>
        <legend class="solo-lectores">Mensaje con iconos</legend>
        <p class="nota">Hasta <%= maxIconos %> iconos, en el orden que quieras.</p>
        <div class="mensaje__desplegables" data-mensaje-desplegables>
          <% for (let n = 1; n <= maxIconos; n++) { %>
            <label class="mensaje__desplegable">
              <span>Icono <%= n %></span>
              <select name="iconos" class="publicar__desplegable">
                <option value="">Ninguno</option>
                <% gruposIconos.forEach((g) => { %><optgroup label="<%= g.texto %>">
                  <% iconosMensaje.filter((i) => i.grupo === g.id).forEach((i) => { %><option value="<%= i.id %>" data-icono="<%= i.icono %>"><%= i.texto %></option>
                <% }) %></optgroup>
                <% }) %>
              </select>
            </label>
          <% } %>
        </div>
      </fieldset>
    </details>
    <% } %>

    <div class="publicar__pie">
      <button type="submit" class="boton publicar__boton">Publicar en el muro</button>
    </div>
  </form>
  </aside>

  <section class="muro" aria-labelledby="titulo-muro">
    <h2 id="titulo-muro" class="muro__titulo">Lo último de los fans</h2>
    <% if (!publicaciones.length) { %>
      <p class="muro__vacio">Todavía no hay publicaciones. ¡Estrena el muro!</p>
    <% } else { %>
      <ol class="muro__lista">
        <% publicaciones.forEach((p) => { %>
          <li>
            <article id="publicacion-<%= p.id %>" class="publicacion" data-publicacion="<%= p.id %>" aria-labelledby="autor-<%= p.id %>">
              <%# La photocard lleva la copia del diseño (la cara del avatar o el sello entero) o, si
                  no hay, la inicial. Los SVG los genera el servidor (nunca el navegador). %>
              <% if (p.dibujo && p.dibujo.tipo === 'avatar') { %>
                <div class="photocard photocard--avatar" data-diseno="avatar" role="img" aria-label="Avatar de <%= p.alias %>"><%- p.dibujo.svg %></div>
              <% } else if (p.dibujo && p.dibujo.tipo === 'sello') { %>
                <div class="photocard photocard--sello" data-diseno="sello" role="img" aria-label="Sello de <%= p.alias %>"><%- include('_sello', { dibujo: p.dibujo.dibujo, ancho: p.dibujo.ancho, clase: 'sello--muro' }) %></div>
              <% } else { %>
                <div class="photocard" aria-hidden="true"><span class="photocard__inicial"><%= p.inicial %></span></div>
              <% } %>
              <div class="publicacion__cuerpo">
                <p class="publicacion__cabeza">
                  <strong id="autor-<%= p.id %>" class="publicacion__alias"><%= p.alias %></strong>
                  <time datetime="<%= p.creadoEn.toISOString() %>"><%= p.hace %></time>
                </p>
                <p class="publicacion__emocion">
                  <img src="<%= p.emocion.icono %>" alt="" width="48" height="48">
                  <span><%= p.emocion.texto %></span>
                </p>
                <%# El mensaje con iconos, con su tipo delante (D084), que también da nombre a la lista. %>
                <% if (p.mensaje && p.mensaje.length) { %>
                  <div class="mensaje-publicado">
                    <span class="mensaje-publicado__tipo" id="tipo-mensaje-<%= p.id %>"><%= p.tipoMensaje.texto %></span>
                    <ul class="mensaje-iconos" aria-labelledby="tipo-mensaje-<%= p.id %>">
                      <% p.mensaje.forEach((i) => { %><li><img src="<%= i.icono %>" alt="<%= i.texto %>" width="28" height="28"></li><% }) %>
                    </ul>
                  </div>
                <% } %>

                <%- include('_reacciones', { p }) %>

                <%# Siempre existe, aunque esté vacío: el script de Connect añade aquí «Tus reacciones»
                    cuando das tu primera reacción, sin recargar. %>
                <div class="publicacion__acciones">
                    <% if (p.totalMias > 0) { %>
                      <details class="desplegable" data-mis-reacciones>
                        <summary>Tus reacciones (<span data-total-mias><%= p.totalMias %></span>)</summary>
                        <form method="post" action="/connect/publicaciones/<%= p.id %>/reacciones/quitar" class="desplegable__contenido">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <button type="submit" name="que" value="ultima" class="boton boton--secundario boton--pequeno">Quitar la última</button>
                          <button type="submit" name="que" value="todas" class="boton boton--secundario boton--pequeno">Quitar todas las mías</button>
                        </form>
                      </details>
                    <% } %>
                    <% if (p.esMia) { %>
                      <details class="desplegable">
                        <summary>Borrar</summary>
                        <form method="post" action="/connect/publicaciones/<%= p.id %>/eliminar" class="desplegable__contenido">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <p class="desplegable__texto">¿Borrar esta publicación? No se puede deshacer.</p>
                          <button type="submit" class="boton boton--peligro boton--pequeno">Sí, borrar</button>
                        </form>
                      </details>
                    <% } %>
                </div>
              </div>
            </article>
          </li>
        <% }) %>
      </ol>
    <% } %>
  </section>
  </div>
</div>

<%# Para el script de Connect: el aviso que leen los lectores de pantalla al reaccionar sin recargar,
    y la plantilla de «Tus reacciones» que copia en una publicación cuando das tu primera reacción. %>
<p id="connect-aviso" class="solo-lectores" aria-live="polite"></p>
<template id="plantilla-mis-reacciones">
  <details class="desplegable" data-mis-reacciones>
    <summary>Tus reacciones (<span data-total-mias>0</span>)</summary>
    <form method="post" action="" class="desplegable__contenido">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" name="que" value="ultima" class="boton boton--secundario boton--pequeno">Quitar la última</button>
      <button type="submit" name="que" value="todas" class="boton boton--secundario boton--pequeno">Quitar todas las mías</button>
    </form>
  </details>
</template>
<script src="/js/connect.js" defer></script>
<script src="/js/connect-publicar.js" defer></script>
<%- include('_pie') %>
