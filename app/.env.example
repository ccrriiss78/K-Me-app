# Plantilla de configuración privada de K-ME.
# Copia este archivo como .env.local (en esta misma carpeta app/) y rellena los valores.
# .env.local NUNCA se sube a Git. Esta plantilla no contiene secretos reales.

# Entorno: development | production
NODE_ENV=development

# Puerto del servidor web
PORT=3000

# Conexión a PostgreSQL. Usa un usuario y una base de datos creados solo para K-ME.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=kme_dev
PGUSER=kme_app
PGPASSWORD=CAMBIAR_POR_TU_CONTRASENA

# Secreto para firmar la cookie de sesión. Genera uno largo y aleatorio, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=CAMBIAR_POR_UNA_CADENA_LARGA_Y_ALEATORIA

# Pon COOKIE_SECURE=true solo cuando la app se sirva por HTTPS (despliegue futuro).
COOKIE_SECURE=false
